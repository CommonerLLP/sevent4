{
  "layers": [
    {
      "id": "wards",
      "label": "Wards - service access",
      "file": "wards.geojson",
      "kind": "fill",
      "group": "Civic baseline",
      "default": true,
      "outline": true,
      "popup": [
        "Name",
        "councillor_count",
        "councillor_phones",
        "councillor_roster_status",
        "deprivation",
        "buses_per_stop",
        "transit_desert",
        "brts_stops",
        "service_access",
        "service_priority",
        "libraries",
        "schools",
        "health",
        "gtfs_stops"
      ],
      "paint": {
        "fill-color": ["interpolate", ["linear"], ["to-number", ["get", "deprivation"], 0], 0, "#1f6f8b", 0.45, "#6b7f64", 0.75, "#d9a94f", 0.95, "#c84646"],
        "fill-opacity": 0.55
      }
    },
    {
      "id": "wards_buses",
      "label": "Wards - bus frequency",
      "file": "wards.geojson",
      "kind": "fill",
      "group": "Transit",
      "default": false,
      "outline": true,
      "popup": ["Name", "buses_per_stop", "amts_buses_day", "brts_stops", "transit_desert", "deprivation"],
      "paint": {
        "fill-color": ["interpolate", ["linear"], ["to-number", ["get", "buses_per_stop"], 0], 0, "#9f2d2d", 50, "#d36b32", 90, "#d7b33f", 150, "#2c7a55"],
        "fill-opacity": 0.55
      }
    },
    {
      "id": "ward_heat",
      "label": "Ward heat",
      "file": "ward_heat.geojson",
      "kind": "fill",
      "group": "Climate",
      "default": false,
      "outline": true,
      "popup": ["Name", "mean_lst_c", "max_lst_c"],
      "paint": {
        "fill-color": ["interpolate", ["linear"], ["to-number", ["get", "mean_lst_c"], 35], 32, "#2c7a55", 36, "#d7b33f", 39, "#d36b32", 42, "#9f2d2d"],
        "fill-opacity": 0.58
      }
    },
    {
      "id": "heat30m",
      "label": "Surface heat - 30m",
      "file": "heat30m.png",
      "bounds_file": "heat30m_bounds.json",
      "kind": "image",
      "group": "Climate",
      "default": false,
      "popup": [],
      "paint": {"raster-opacity": 0.78, "raster-resampling": "nearest"}
    },
    {
      "id": "landuse",
